    },
    "Changes can be saved now and applied with Restart or Later.": {
      "comment": "Settings footer describing the restart prompt choices.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes can be saved now and applied with Restart or Later."
          }
        }
      }
    },
    "Checking the previous request; it will not be repeated.": {
      "comment": "Checking a timed-out display setting without applying it twice.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the previous request; it will not be repeated."
          }
        }
      }
    },
    "Choose a device, then tap Apply to save its screen resolution. While running, choose Restart or Later.": {
      "comment": "Device picker instructions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a device, then tap Apply to save its screen resolution. While running, choose Restart or Later."
          }
        }
      }
    },
    "Choose…": {
      "comment": "Placeholder when no simulated device name is available.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose…"
          }
        }
      }
    },
    "Could not save audio output: %s (%d).": {
      "comment": "Settings error: system error description and numeric error code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save audio output: %1$s (%2$d)."
