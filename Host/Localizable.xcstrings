{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\n%@": {
      "comment": "Settings footer: explanatory paragraph, then current status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n%2$@"
          }
        }
      }
    },
    "%@\n\nFull width preserves the screen’s aspect ratio and fits within the available height.": {
      "comment": "Device settings footer: current status followed by the Full Width explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nFull width preserves the screen’s aspect ratio and fits within the available height."
          }
        }
      }
    },
    "%ld · %@": {
      "comment": "Performance HUD row: numeric mode identifier, then localized mode name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$ld · %2$@"
          }
        }
      }
    },
    "Apply": {
      "comment": "Save the selected simulated device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        }
      }
    },
    "Applying simulator configuration": {
      "comment": "Accessibility label for the device settings progress indicator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying simulator configuration"
          }
        }
      }
    },
    "Audio output": {
      "comment": "Switch for simulator audio playback on the physical device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio output"
          }
        }
      }
    },
    "Audio playback stopped: %@": {
      "comment": "Background audio error",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio playback stopped: %@"
