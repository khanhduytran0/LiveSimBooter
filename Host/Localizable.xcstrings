        }
      }
    },
    "Audio unavailable": {
      "comment": "Fallback background audio failure reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio unavailable"
          }
        }
      }
    },
    "Backdrop": {
      "comment": "Performance HUD mode for backdrop rendering.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backdrop"
          }
