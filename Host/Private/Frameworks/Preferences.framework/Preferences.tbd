--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name: '/System/Library/PrivateFrameworks/Preferences.framework/Preferences'
current-version: 1
compatibility-version: 1
exports:
  - targets: [ arm64-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    objc-classes: [ PSViewController, PSListController, PSSpecifier, PSTableCell, PSSubtitleButtonCell ]
    symbols: [ _PSEnabledKey, _PSFooterTextGroupKey, _PSIDKey, _PSCellClassKey,
               _PSKeyNameKey, _PSValueKey, _PSDefaultValueKey ]
...
